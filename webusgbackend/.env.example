PORT=5000
NODE_ENV=development

# Local or Atlas connection string (replace <db_password> or provide DB_PASSWORD)
# MONGODB_URI=mongodb+srv://usgdb:<db_password>@cluster0.2lkpovq.mongodb.net/usg_db?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/webusg
DB_PASSWORD=your_mongodb_atlas_password_here

# Must be at least 32 characters. Rotate in production.
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=1h
JWT_ISSUER=webusg-api
JWT_AUDIENCE=webusg-client

BCRYPT_SALT_ROUNDS=12

# Comma-separated browser origins. Required in production; empty allows any origin in development only.
CORS_ORIGINS=http://localhost:3000

AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Used only by `npm run seed:admin`. Do not start the server with these as a substitute for seeding.
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-secure-password
